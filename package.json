{
  "name": "power-glove",
  "displayName": "Power Glove",
  "author": "Mateusz Matt Szymonski <mattszymonski@gmail.com>",
  "description": "Compact command-runner with per-machine overrides.",
  "version": "1.0.0",
  "publisher": "MattSzymonski",
  "repository": {
    "type": "git",
    "url": "https://github.com/MattSzymonski/Power-Glove"
  },
  "license": "MIT",
  "icon": "media/power_glove_icon_128.png",
  "keywords": [
    "vscode",
    "extension",
    "commands",
    "cli",
    "runner",
    "actions"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "powerGlove.commands",
          "name": "Power Glove",
          "icon": "media/power_glove_icon_128.png",
          "contextualTitle": "Power Glove Commands"
        }
      ]
    },
    "commands": [
      {
        "command": "powerGlove.openUI",
        "title": "Power Glove: Open"
      },
      {
        "command": "powerGlove.openManager",
        "title": "Power Glove: Manage Commands (UI)"
      },
      {
        "command": "powerGlove.openManagerJson",
        "title": "Power Glove: Manage Commands (JSON)"
      },
      {
        "command": "powerGlove.runInCurrentTerminal",
        "title": "Power Glove: Run In Current Terminal"
      },
      {
        "command": "powerGlove.runInNewTerminal",
        "title": "Power Glove: Run In New Terminal"
      },
      {
        "command": "powerGlove.runRecent",
        "title": "Power Glove: Run Recent Command"
      },
      {
        "command": "powerGlove.tree.runCurrent",
        "title": "Run in Current Terminal",
        "icon": "$(play)"
      },
      {
        "command": "powerGlove.tree.runNew",
        "title": "Run in New Terminal",
        "icon": "$(terminal-new)"
      },
      {
        "command": "powerGlove.tree.showInfo",
        "title": "Show Command Details",
        "icon": "$(info)"
      },
      {
        "command": "powerGlove.refreshTree",
        "title": "Refresh Commands",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Power Glove",
      "properties": {
        "powerGlove.commandsFilePath": {
          "type": "string",
          "default": "",
          "description": "Path to the JSON file where Power Glove commands are stored. Leave empty to use the default location inside VS Code's global storage."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "powerGlove.refreshTree",
          "when": "view == powerGlove.commands",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "powerGlove.tree.runCurrent",
          "when": "view == powerGlove.commands && viewItem == command",
          "group": "inline@1"
        },
        {
          "command": "powerGlove.tree.runNew",
          "when": "view == powerGlove.commands && viewItem == command",
          "group": "inline@2"
        },
        {
          "command": "powerGlove.tree.showInfo",
          "when": "view == powerGlove.commands && viewItem == command",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}